@model DataAccess.Model.Restaurant

@{
    ViewData["Title"] = "Manager Dashboard";
}

<div class="container mt-4">
    <h2>Manager Dashboard</h2>

    <div class="management-panel">

        <!-- Welcome -->
        <div class="management-section">
            <div class="management-section-header">
                <h4>Welcome, @Model.Name</h4>
            </div>

            <div class="management-content">
                <p>
                    Manage your restaurant, menus, food items and online ordering
                    from this dashboard.
                </p>

                <p><strong>Restaurant ID:</strong> @Model.RestaurantId</p>

                <a asp-controller="Manager"
                   asp-action="SelectRestaurant"
                   class="btn btn-outline-secondary">
                    Change Restaurant
                </a>
            </div>
        </div>

        <!-- Management sections -->
        <div class="manager-grid">

            <div class="management-section">
                <div class="management-section-header">
                    <h5>Food Items</h5>
                </div>

                <div class="management-content">
                    <p>Create, edit and remove food items and their prices.</p>

                    <a asp-controller="Manager"
                       asp-action="FoodItems"
                       class="btn btn-success">
                        Manage Food Items
                    </a>
                </div>
            </div>

            <div class="management-section">
                <div class="management-section-header">
                    <h5>Menu Management</h5>
                </div>

                <div class="management-content">
                    <p>Organize food items into categories and manage menus.</p>

                    <a asp-controller="Manager"
                       asp-action="Categories"
                       class="btn btn-success">
                        Manage Categories
                    </a>
                </div>
            </div>

            <div class="management-section">
                <div class="management-section-header">
                    <h5>Online Ordering</h5>
                </div>

                <div class="management-content">
                    <p>Control whether customers can place online orders.</p>

                    <button class="btn btn-secondary" disabled>
                        Coming Soon
                    </button>
                </div>
            </div>

            <div class="management-section">
                <div class="management-section-header">
                    <h5>Restaurant Details</h5>
                </div>

                <div class="management-content">
                    <p>Manage your restaurant's information and settings.</p>

                    <button class="btn btn-secondary" disabled>
                        Coming Soon
                    </button>
                </div>
            </div>

        </div>
    </div>
</div>

<style>
    .management-panel {
        padding: 2rem;
        background: white;
        border: 2px solid #dce8dc;
        border-radius: 18px;
    }

    .management-section {
        border: 2px solid #dce8dc;
        border-radius: 14px;
        overflow: hidden;
        background: white;
    }

    .management-section-header {
        padding: 1rem 1.5rem;
        background: #f0f6ed;
        border-bottom: 2px solid #dce8dc;
    }

        .management-section-header h4,
        .management-section-header h5 {
            margin: 0;
        }

    .management-content {
        padding: 1.5rem;
    }

    .manager-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
        gap: 1.5rem;
        margin-top: 1.5rem;
    }

    .management-content p {
        margin-bottom: 1rem;
    }
</style>