@model List<DataAccess.Model.Restaurant>

@{
    ViewData["Title"] = "Home view";
}

<!-- Full-screen background -->
<div class="home-background"></div>

<!-- Page content -->
<div class="home-content">

    <!-- Welcome heading -->
    <div class="welcome-container">
        <div class="welcome-box">
            <h1>Vælg din restaurant</h1>
            <h2>Find din næste favoritret</h2>
        </div>
    </div>

    <!-- Restaurants loaded from the database -->
    <div class="container">
        <div class="row justify-content-center g-4">

            @if (Model == null || Model.Count == 0)
            {
                <div class="col-12 text-center">
                    <div class="welcome-box">
                        <h2>Ingen restauranter fundet</h2>
                        <p>Der er ingen restauranter at vise lige nu.</p>
                    </div>
                </div>
            }
            else
            {
                @foreach (var restaurant in Model)
                {
                    <div class="col-12 col-md-6 col-lg-5">
                        <a asp-controller="Restaurant"
                           asp-action="Index"
                           asp-route-id="@restaurant.RestaurantId"
                           class="restaurant-link">

                            <div class="card restaurant-card h-100 shadow-sm">

                                <div class="restaurant-image-placeholder">
                                    <span class="restaurant-icon">🍽️</span>
                                </div>

                                <div class="card-body">
                                    <h3 class="card-title">
                                        @restaurant.Name
                                    </h3>

                                    <p class="card-text">
                                        @if (restaurant.IsAcceptingOrders)
                                        {
                                            <span>
                                                Vi modtager bestillinger.
                                            </span>
                                        }
                                        else
                                        {
                                            <span>
                                                Vi modtager ikke bestillinger
                                                lige nu.
                                            </span>
                                        }
                                    </p>

                                    @if (restaurant.IsAcceptingOrders)
                                    {
                                        <span class="btn btn-primary btn-lg">
                                            Vælg restaurant
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="btn btn-secondary btn-lg">
                                            Se restaurant
                                        </span>
                                    }
                                </div>

                            </div>
                        </a>
                    </div>
                }
            }

        </div>
    </div>
</div>


<style>
    /* Full-screen background */
    .home-background {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: -1;
        background:
            linear-gradient(
                rgba(0, 0, 0, 0.25),
                rgba(0, 0, 0, 0.25)
            ),
            url('/images/sommerland.png') center / cover no-repeat;
    }

    /* Main page content */
    .home-content {
        position: relative;
        z-index: 1;
        padding: 1rem 0 3rem;
    }

    /* Center the welcome box */
    .welcome-container {
        display: flex;
        justify-content: center;
        width: 100%;
        padding: 0 1rem;
        margin-bottom: 1.5rem;
    }

    /* Welcome box appearance */
    .welcome-box {
        padding: 1rem 2rem;
        max-width: 90%;
        background: rgba(20, 35, 25, 0.65);
        border: 2px solid rgba(255, 255, 255, 0.8);
        border-radius: 24px;
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.3);
        backdrop-filter: blur(6px);
        color: white;
        text-align: center;
    }

    .welcome-box h1 {
        color: white;
        font-size: clamp(1.4rem, 3vw, 2.2rem);
        font-weight: 800;
        letter-spacing: 0.3px;
        text-shadow: 2px 3px 5px rgba(0, 0, 0, 0.6);
        margin-bottom: 0.5rem;
    }

    .welcome-box h2 {
        color: white;
        font-size: clamp(1rem, 2vw, 1.4rem);
        font-weight: 600;
        text-shadow: 1px 2px 4px rgba(0, 0, 0, 0.6);
        margin-bottom: 0;
    }

    /* Clickable restaurant cards */
    .restaurant-link {
        display: block;
        height: 100%;
        color: inherit;
        text-decoration: none;
    }

    .restaurant-card {
        border: none;
        border-radius: 16px;
        overflow: hidden;
        transition: transform 0.2s ease,
                    box-shadow 0.2s ease;
    }

    .restaurant-link:hover .restaurant-card {
        transform: translateY(-6px);
        box-shadow: 0 12px 25px rgba(0, 0, 0, 0.2) !important;
    }

    /* Restaurant images */
    .restaurant-image {
        width: 100%;
        height: 280px;
        object-fit: cover;
    }

    .restaurant-card .card-body {
        padding: 1.5rem;
    }

    /* Smaller images on mobile */
    @@media (max-width: 767px) {
        .restaurant-image {
            height: 220px;
        }

        .welcome-box {
            padding: 0.8rem 1.2rem;
        }
    }
</style>
