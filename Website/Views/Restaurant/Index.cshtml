@model DataAccess.Model.Restaurant
@using Website.Extensions
@using Website.Models

@{
    ViewData["Title"] = "Menu";
    var restaurant = Model;

    var foodItems = restaurant?.Menus
        .Where(menu => menu.IsActive)
        .SelectMany(menu => menu.Categories)
        .SelectMany(category => category.FoodItems
            .Where(item => item.IsAvailable)
            .Select(item => new
            {
                item.FoodItemId,
                item.Name,
                item.Description,
                item.Prices,
                Category = category.Name
            }))
        .ToList() ?? new();

    var cart = Context.Session
        .GetObject<List<CartItem>>("MealMateCart") ?? new();

    var cartCount = cart.Sum(item => item.Quantity);
    var cartTotal = cart.Sum(item => item.SubTotal);
    var cartOpen = Context.Request.Query["cartOpen"] == "true";
}

<div class="home-background"></div>

<!-- Top header -->
<header class="menu-header">
    <div class="header-inner">

        <div class="menu-topline">
            <a asp-controller="Home"
               asp-action="Index"
               class="back-link">
                ← Tilbage til restauranter
            </a>

            <button type="button"
                    class="cart-toggle"
                    id="cartToggle"
                    aria-controls="cartPanel"
                    aria-expanded="@(cartOpen ? "true" : "false")">
                🛒 Kurv (<span id="cartCount">@cartCount</span>)
            </button>
        </div>

        <div class="welcome-container">
            <div class="welcome-box">
                <h1>@restaurant?.Name</h1>
                <h2>
                    Find din favorit, og gør dig klar til et lækkert måltid.
                </h2>
            </div>
        </div>

    </div>
</header>

<!-- Main menu -->
@if (TempData["CartWarning"] is string warning)
{
    <div id="cartWarningPopup" class="cart-warning-overlay">
        <div class="cart-warning-popup" role="alert">
            <div class="cart-warning-icon">⚠️</div>
            <h2>Hey, vent lige!</h2>
            <p>@warning</p>
        </div>
    </div>
}
<main class="menu-page">

    <div class="menu-toolbar">
        <span class="menu-count">
            @foodItems.Count lækre valgmuligheder
        </span>

        @if (restaurant != null && !restaurant.IsAcceptingOrders)
        {
            <span class="restaurant-number">
                Restauranten modtager ikke bestillinger lige nu
            </span>
        }
    </div>

    @if (foodItems.Count == 0)
    {
        <div class="no-food">
            <h2>Ingen retter tilgængelige</h2>
            <p>Der er ingen tilgængelige retter på menuen lige nu.</p>
        </div>
    }
    else
    {
        <div class="food-grid">
            @foreach (var item in foodItems)
            {
                var currentPrice = item.Prices
                    .OrderByDescending(price => price.ValidFrom)
                    .FirstOrDefault();

                <article class="food-card">
                    <div class="food-image">
                        <span class="food-emoji">🍽️</span>
                        <span class="food-category">@item.Category</span>
                    </div>

                    <div class="food-content">
                        <h2>@item.Name</h2>
                        <p>@item.Description</p>

                        <div class="food-footer">
                            <span class="food-price">
                                @if (currentPrice != null)
                                {
                                    @($"{currentPrice.Amount:0.00} kr.")
                                }
                                else
                                {
                                    <text>Pris ikke tilgængelig</text>
                                }
                            </span>

                            @if (restaurant != null &&
                                 restaurant.IsAcceptingOrders &&
                                 currentPrice != null)
                            {
                                <form asp-controller="Cart"
                                      asp-action="Add"
                                      method="post">
                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="foodItemId"
                                           value="@item.FoodItemId" />

                                    <input type="hidden"
                                           name="restaurantId"
                                           value="@restaurant.RestaurantId" />

                                    <input type="hidden"
                                           name="quantity"
                                           value="1" />

                                    <button type="submit"
                                            class="add-button">
                                        + Tilføj
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>
    }

</main>

<!-- Dark overlay behind the cart -->
<div class="cart-overlay @(cartOpen ? "is-visible" : "")"
     id="cartOverlay">
</div>

<!-- Slide-out shopping cart -->
<aside class="cart-panel @(cartOpen ? "is-open" : "")"
       id="cartPanel"
       aria-label="Indkøbskurv"
       aria-hidden="@(!cartOpen ? "true" : "false")">

    <div class="cart-header">
        <div>
            <h2>Din indkøbskurv</h2>
            <span class="cart-subtitle">
                <span id="panelCartCount">@cartCount</span> varer
            </span>
        </div>

        <button type="button"
                class="cart-close"
                id="cartClose"
                aria-label="Luk indkøbskurv">
            ×
        </button>
    </div>

    <div class="cart-items" id="cartItems">
        @if (!cart.Any())
        {
            <div class="cart-empty">
                <span>🛒</span>
                <h3>Kurven er tom</h3>
                <p>Tilføj en lækker ret fra menuen.</p>
            </div>
        }
        else
        {
            @foreach (var item in cart)
            {
                <div class="cart-item">
                    <div class="cart-item-info">
                        <h3>@item.Name</h3>

                        <span>
                            @item.UnitPrice.ToString("0.00") kr. pr. stk.
                        </span>

                        <strong>
                            @item.SubTotal.ToString("0.00") kr.
                        </strong>
                    </div>

                    <div class="cart-item-actions">
                        <span>Antal: @item.Quantity</span>

                        <form asp-controller="Cart"
                              asp-action="Remove"
                              method="post">
                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="foodItemId"
                                   value="@item.FoodItemId" />

                            <input type="hidden"
                                   name="restaurantId"
                                   value="@item.RestaurantId" />

                            <button type="submit"
                                    class="remove-button">
                                Fjern
                            </button>
                        </form>
                    </div>
                </div>
            }
        }
    </div>

    <div class="cart-footer">
        <div class="cart-total">
            <span>Total</span>
            <strong id="cartTotal">
                @cartTotal.ToString("0.00") kr.
            </strong>
        </div>

        <button type="button"
                class="checkout-button"
                disabled="@(!cart.Any())">
            Gå til bestilling →
        </button>

        <p class="checkout-note">
            Bestillingsfunktionen tilføjes senere.
        </p>
    </div>

</aside>

<style>
    /* Background */
    .home-background {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: -1;
        background: linear-gradient( rgba(0, 0, 0, .25), rgba(0, 0, 0, .25) ), url('/images/sommerland.png') center / cover no-repeat;
    }

    /* Top header */
    .menu-header {
        width: 100%;
        margin: 0;
        padding: 1rem 2rem 0;
    }

    .header-inner {
        max-width: 1500px;
        margin: 0 auto;
    }

    .menu-topline {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        width: 100%;
        margin-bottom: 1rem;
    }

    .back-link {
        display: inline-block;
        color: white;
        text-decoration: none;
        font-weight: 600;
        text-shadow: 1px 1px 3px rgba(0, 0, 0, .5);
    }

        .back-link:hover {
            text-decoration: underline;
        }

    /* Cart button at the top right */
    .cart-toggle {
        margin-left: auto;
        flex-shrink: 0;
        border: 0;
        border-radius: 12px;
        background: #36784a;
        color: white;
        padding: .75rem 1.25rem;
        font-weight: 700;
        font-size: 1rem;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(0, 0, 0, .2);
        transition: background .2s ease;
    }

        .cart-toggle:hover {
            background: #285e39;
        }

    /* Restaurant heading */
    .welcome-container {
        display: flex;
        justify-content: center;
        width: 100%;
        padding: 0 1rem;
        margin-bottom: 1.5rem;
    }

    .welcome-box {
        width: fit-content;
        max-width: 90%;
        padding: 1rem 2rem;
        background: rgba(20, 35, 25, .65);
        border: 2px solid rgba(255, 255, 255, .8);
        border-radius: 24px;
        box-shadow: 0 6px 18px rgba(0, 0, 0, .3);
        backdrop-filter: blur(6px);
        color: white;
        text-align: center;
    }

        .welcome-box h1 {
            color: white;
            font-size: clamp(1.4rem, 3vw, 2.2rem);
            font-weight: 800;
            letter-spacing: .3px;
            text-shadow: 2px 3px 5px rgba(0, 0, 0, .6);
            margin: 0 0 .5rem;
        }

        .welcome-box h2 {
            color: white;
            font-size: clamp(1rem, 2vw, 1.4rem);
            font-weight: 600;
            text-shadow: 1px 2px 4px rgba(0, 0, 0, .6);
            margin: 0;
        }

    /* Main menu */
    .menu-page {
        max-width: 1500px;
        margin: 0 auto;
        padding: 0 2rem 4rem;
    }

    .menu-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.25rem;
        color: white;
        font-size: .9rem;
        text-shadow: 1px 1px 3px rgba(0, 0, 0, .5);
    }

    .menu-count {
        font-weight: 600;
    }

    .restaurant-number {
        background: #edf4ed;
        color: #376b49;
        border-radius: 20px;
        padding: .4rem .8rem;
        font-weight: 600;
        text-shadow: none;
    }

    .no-food {
        padding: 2rem;
        border-radius: 18px;
        background: white;
        color: #24382a;
    }

    /* Food grid */
    .food-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1.5rem;
    }

    .food-card {
        min-width: 0;
        overflow: hidden;
        border: 1px solid #e7ebe7;
        border-radius: 18px;
        background: white;
        box-shadow: 0 5px 18px rgba(24, 48, 30, .06);
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .food-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 28px rgba(24, 48, 30, .12);
        }

    .food-image {
        min-height: 155px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #edf4e9, #faf1df);
        position: relative;
    }

    .food-emoji {
        font-size: 4.5rem;
    }

    .food-category {
        position: absolute;
        top: .75rem;
        left: .75rem;
        padding: .3rem .65rem;
        background: rgba(255, 255, 255, .9);
        color: #376b49;
        border-radius: 20px;
        font-size: .75rem;
        font-weight: 700;
    }

    .food-content {
        padding: 1.25rem;
    }

        .food-content h2 {
            font-size: 1.25rem;
            font-weight: 750;
            color: #24382a;
            margin: 0 0 .5rem;
            overflow-wrap: anywhere;
        }

        .food-content p {
            min-height: 3rem;
            color: #68736b;
            font-size: .92rem;
            line-height: 1.5;
            margin-bottom: 1.25rem;
            overflow-wrap: anywhere;
        }

    .food-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: .5rem;
        flex-wrap: wrap;
    }

    .food-price {
        font-size: 1.1rem;
        font-weight: 800;
        color: #24382a;
        white-space: nowrap;
    }

    .add-button {
        border: 0;
        border-radius: 10px;
        background: #36784a;
        color: white;
        padding: .65rem .9rem;
        font-weight: 700;
        cursor: pointer;
    }

        .add-button:hover {
            background: #285e39;
        }

    /* Dark overlay when cart is open */
    .cart-overlay {
        position: fixed;
        inset: 0;
        background: rgba(20, 30, 22, .35);
        opacity: 0;
        visibility: hidden;
        transition: opacity .25s ease, visibility .25s ease;
        z-index: 1040;
    }

        .cart-overlay.is-visible {
            opacity: 1;
            visibility: visible;
        }

    /* Slide-out cart */
    .cart-panel {
        position: fixed;
        top: 0;
        right: 0;
        width: min(430px, 100%);
        height: 100dvh;
        background: white;
        z-index: 1050;
        box-shadow: -12px 0 35px rgba(0, 0, 0, .15);
        display: flex;
        flex-direction: column;
        transform: translateX(105%);
        transition: transform .25s ease;
    }

        .cart-panel.is-open {
            transform: translateX(0);
        }

    .cart-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.5rem;
        border-bottom: 1px solid #e7ebe7;
        flex-shrink: 0;
    }

        .cart-header h2 {
            margin: 0;
            color: #24382a;
        }

    .cart-subtitle {
        color: #68736b;
        font-size: .9rem;
    }

    .cart-close {
        border: 0;
        background: #edf4e9;
        color: #24382a;
        border-radius: 50%;
        width: 40px;
        height: 40px;
        font-size: 1.7rem;
        cursor: pointer;
    }

    .cart-items {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        padding: 1rem 1.5rem;
    }

    .cart-empty {
        text-align: center;
        padding: 4rem 1rem;
        color: #68736b;
    }

        .cart-empty span {
            font-size: 3rem;
        }

        .cart-empty h3 {
            color: #24382a;
        }

    .cart-item {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        padding: 1rem 0;
        border-bottom: 1px solid #e7ebe7;
    }

    .cart-item-info {
        min-width: 0;
        overflow-wrap: anywhere;
    }

        .cart-item-info h3 {
            margin: 0 0 .4rem;
            font-size: 1rem;
            color: #24382a;
        }

        .cart-item-info span {
            display: block;
            font-size: .85rem;
            color: #68736b;
            margin-bottom: .5rem;
        }

        .cart-item-info strong {
            color: #24382a;
        }

    .cart-item-actions {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: .5rem;
        flex-shrink: 0;
        font-size: .9rem;
    }

    .remove-button {
        border: 0;
        background: transparent;
        color: #a83232;
        cursor: pointer;
        text-decoration: underline;
    }

    /* Cart footer */
    .cart-footer {
        border-top: 1px solid #e7ebe7;
        padding: 1.5rem;
        flex-shrink: 0;
        background: white;
    }

    .cart-total {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
        color: #24382a;
        font-size: 1.1rem;
    }

        .cart-total strong {
            font-size: 1.35rem;
        }

    .checkout-button {
        width: 100%;
        border: 0;
        border-radius: 12px;
        padding: 1rem;
        background: #36784a;
        color: white;
        font-weight: 700;
    }

        .checkout-button:disabled {
            background: #aab8ac;
            cursor: not-allowed;
        }

    .checkout-note {
        margin: .75rem 0 0;
        text-align: center;
        color: #68736b;
        font-size: .8rem;
    }

    /* Responsive design */
    @@media (max-width: 800px) {
        .food-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 520px) {
        .menu-header {
            padding: .75rem 1rem 0;
        }

        .menu-page {
            padding: 0 1rem 2rem;
        }

        .food-grid {
            grid-template-columns: 1fr;
        }

        .menu-toolbar {
            flex-direction: column;
            align-items: flex-start;
        }

        .menu-topline {
            gap: .5rem;
        }

        .back-link {
            font-size: .85rem;
        }

        .cart-toggle {
            padding: .65rem .8rem;
            font-size: .9rem;
        }

        .welcome-box {
            max-width: 100%;
            padding: 1rem;
        }
    }

    /* Popup når brugeren prøver at blande restauranter i kurven */
    .cart-warning-overlay {
        position: fixed;
        inset: 0;
        z-index: 2000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        background: rgba(0, 0, 0, 0.55);
        animation: warningFadeIn 0.25s ease;
    }

    .cart-warning-popup {
        width: min(450px, 100%);
        padding: 2rem;
        border-radius: 20px;
        background: #fff;
        color: #24382a;
        text-align: center;
        box-shadow: 0 15px 50px rgba(0, 0, 0, 0.3);
        animation: warningPopIn 0.3s ease;
    }

    .cart-warning-icon {
        font-size: 3rem;
        margin-bottom: 0.5rem;
    }

    .cart-warning-popup h2 {
        margin-bottom: 0.75rem;
        font-weight: 800;
    }

    .cart-warning-popup p {
        margin: 0;
        line-height: 1.6;
        color: #555;
    }

    @@keyframes warningFadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    @@keyframes warningPopIn {
        from {
            opacity: 0;
            transform: scale(0.85);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    @@keyframes warningFadeOut {
        to {
            opacity: 0;
            transform: scale(0.95);
        }
    }

</style>

<script>
    (() => {
        const panel = document.getElementById("cartPanel");
        const overlay = document.getElementById("cartOverlay");
        const toggle = document.getElementById("cartToggle");
        const close = document.getElementById("cartClose");

        function openCart() {
            panel.classList.add("is-open");
            overlay.classList.add("is-visible");

            panel.setAttribute("aria-hidden", "false");
            toggle.setAttribute("aria-expanded", "true");
        }

        function closeCart() {
            panel.classList.remove("is-open");
            overlay.classList.remove("is-visible");

            panel.setAttribute("aria-hidden", "true");
            toggle.setAttribute("aria-expanded", "false");
        }

        toggle.addEventListener("click", () => {
            if (panel.classList.contains("is-open")) {
                closeCart();
            } else {
                openCart();
            }
        });

        close.addEventListener("click", closeCart);
        overlay.addEventListener("click", closeCart);

        if (new URLSearchParams(window.location.search)
            .get("cartOpen") === "true") {
            openCart();
        }

        document.addEventListener("keydown", event => {
            if (event.key === "Escape") {
                closeCart();
            }
        });

            // Luk advarsels-popup efter 3 sekunder
            const warningPopup = document.getElementById("cartWarningPopup");
            if (warningPopup) {
                setTimeout(() => {
                    warningPopup.style.animation = "warningFadeOut 0.3s ease forwards";
                    setTimeout(() => warningPopup.remove(), 300);
                }, 3000);
            }
        })();
</script>
