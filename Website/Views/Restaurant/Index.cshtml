            font-weight: 700;
            cursor: pointer;
        }

            .ingredient-controls button:hover {
                background: #285e39;
            }

    .ingredient-quantity {
        min-width: 18px;
        text-align: center;
        font-weight: 700;
        color: #24382a;
    }

    .add-button {
        width: 100%;
        margin-top: 1rem;
        border: 0;
        border-radius: 10px;
        background: #36784a;
        color: white;
        padding: .75rem .9rem;
        font-weight: 700;
        cursor: pointer;
    }

        .add-button:hover {
            background: #285e39;
        }

    .no-ingredients {
        color: #68736b;
        font-size: .9rem;
    }

    .cart-overlay {
        position: fixed;
        inset: 0;
        background: rgba(20,30,22,.35);
        opacity: 0;
        visibility: hidden;
        transition: opacity .25s ease, visibility .25s ease;
        z-index: 1040;
    }

        .cart-overlay.is-visible {
            opacity: 1;
            visibility: visible;
        }

    .cart-panel {
        position: fixed;
        top: 0;
        right: 0;
        width: min(430px,100%);
