    /* Warning popup */
    .cart-warning-overlay {
        position: fixed;
        inset: 0;
        z-index: 2000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        background: rgba(0,0,0,.55);
        animation: warningFadeIn .25s ease;
    }

    .cart-warning-popup {
        width: min(450px,100%);
        padding: 2rem;
        border-radius: 20px;
        background: white;
        color: #24382a;
        text-align: center;
        box-shadow: 0 15px 50px rgba(0,0,0,.3);
        animation: warningPopIn .3s ease;
    }

    .cart-warning-icon {
        font-size: 3rem;
        margin-bottom: .5rem;
    }

    .cart-warning-popup h2 {
        margin-bottom: .75rem;
        font-weight: 800;
    }

    .cart-warning-popup p {
        margin: 0;
        line-height: 1.6;
        color: #555;
    }

    @@keyframes warningFadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    @@keyframes warningPopIn {
        from {
            opacity: 0;
            transform: scale(.85);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    @@keyframes warningFadeOut {
        to {
            opacity: 0;
            transform: scale(.95);
        }
    }

    @@media (max-width: 800px) {
        .food-grid {
            grid-template-columns: repeat(2,minmax(0,1fr));
        }
    }

    @@media (max-width: 520px) {
        .menu-header {
            padding: .75rem 1rem 0;
        }

        .menu-page {
            padding: 0 1rem 2rem;
        }

        .food-grid {
            grid-template-columns: 1fr;
        }

        .menu-toolbar {
            flex-direction: column;
            align-items: flex-start;
        }

        .menu-topline {
            gap: .5rem;
        }

        .back-link {
            font-size: .85rem;
        }

        .cart-toggle {
            padding: .65rem .8rem;
            font-size: .9rem;
        }

        .welcome-box {
            max-width: 100%;
            padding: 1rem;
        }
    }
</style>

<script>
    (() => {
        // Kurv
        const panel = document.getElementById("cartPanel");
        const overlay = document.getElementById("cartOverlay");
        const toggle = document.getElementById("cartToggle");
        const close = document.getElementById("cartClose");

        function openCart() {
            panel.classList.add("is-open");
            overlay.classList.add("is-visible");
            panel.setAttribute("aria-hidden", "false");
            toggle.setAttribute("aria-expanded", "true");
        }

        function closeCart() {
            panel.classList.remove("is-open");
            overlay.classList.remove("is-visible");
            panel.setAttribute("aria-hidden", "true");
            toggle.setAttribute("aria-expanded", "false");
        }

        toggle.addEventListener("click", () => {
            if (panel.classList.contains("is-open")) {
                closeCart();
            } else {
                openCart();
            }
        });

        close.addEventListener("click", closeCart);
        overlay.addEventListener("click", closeCart);

        if (new URLSearchParams(window.location.search)
            .get("cartOpen") === "true") {
            openCart();
        }

        document.addEventListener("keydown", event => {
            if (event.key === "Escape") {
                closeCart();
            }
        });

        // Tilpasning af food items
        document.querySelectorAll(".customize-form").forEach(form => {
            const toggleButton =
                form.querySelector(".customize-toggle");

            const dropdown =
                form.querySelector(".ingredient-dropdown");

            const priceElement =
                form.querySelector(".dynamic-price");

            const basePrice =
                parseFloat(priceElement.dataset.basePrice);

            
            toggleButton.addEventListener("click", () => {
                dropdown.classList.toggle("hidden");

                const isOpen = !dropdown.classList.contains("hidden");

                toggleButton.setAttribute(
                    "aria-expanded",
                    isOpen ? "true" : "false"
                );

                toggleButton.textContent = isOpen
                    ? "Luk tilpasning ▲"
                    : "Tilpas ret ▼";
            });


            function updatePrice() {
                let total = basePrice;

                form.querySelectorAll(".ingredient-row").forEach(row => {
                    const extraPrice =
                        parseFloat(row.dataset.price) || 0;

                    const quantity = parseInt(
                        row.querySelector(".ingredient-quantity")
                            .textContent
                    ) || 0;

                    total += extraPrice * quantity;
                });

                priceElement.textContent =
                    total.toFixed(2) + " kr.";
            }

            function updateIngredient(row, change) {
                const quantityElement = row.querySelector(".ingredient-quantity");
                const selectedInput = row.querySelector(".ingredient-selected");

                let quantity = parseInt(quantityElement.textContent) || 0;

                // Hver ingrediens kan vælges 0 eller 1 gang.
                quantity = Math.max(0, Math.min(1, quantity + change));

                // Opdater det viste antal.
                quantityElement.textContent = quantity;

                // Send kun ingrediensens ID, hvis den er valgt.
                if (quantity === 1) {
                    selectedInput.disabled = false;
                } else {
                    selectedInput.disabled = true;
                }

                updatePrice();
            }

            form.querySelectorAll(".ingredient-plus").forEach(button => {
                button.addEventListener("click", () => {
                    const row = button.closest(".ingredient-row");
                    updateIngredient(row, 1);
                });
            });

            form.querySelectorAll(".ingredient-minus").forEach(button => {
                button.addEventListener("click", () => {
                    const row = button.closest(".ingredient-row");
                    updateIngredient(row, -1);
                });
            });

            updatePrice();
        });

        // Luk warning popup efter 3 sekunder
        const warningPopup =
            document.getElementById("cartWarningPopup");

        if (warningPopup) {
            setTimeout(() => {
                warningPopup.style.animation =
                    "warningFadeOut .3s ease forwards";

                setTimeout(() => {
                    warningPopup.remove();
                }, 300);
            }, 3000);
        }
    })();
</script>
