@model DataAccess.Model.Restaurant
@using DataAccess.Model
@using Website.Extensions
@using Website.Models
@using System.Globalization

@{
    ViewData["Title"] = "Menu";
    var restaurant = Model;

    var foodItems = restaurant?.Menus
        .Where(menu => menu.IsActive)
        .SelectMany(menu => menu.Categories)
        .SelectMany(category => category.FoodItems
            .Where(item => item.IsAvailable)
            .Select(item => new
            {
                item.FoodItemId,
                item.Name,
                item.Description,
                item.Prices,
                item.Ingredients,
                Category = category.Name
            }))
        .ToList() ?? new();

    var cart = Context.Session
        .GetObject<List<CartItem>>("MealMateCart") ?? new();

    var cartCount = cart.Sum(item => item.Quantity);
    var cartTotal = cart.Sum(item => item.SubTotal);
    var cartOpen = Context.Request.Query["cartOpen"] == "true";
}

<div class="home-background"></div>

<header class="menu-header">
    <div class="header-inner">
        <div class="menu-topline">
            <a asp-controller="Home"
               asp-action="Index"
               class="back-link">
                ← Tilbage til restauranter
            </a>

            <button type="button"
                    class="cart-toggle"
                    id="cartToggle"
                    aria-controls="cartPanel"
                    aria-expanded="@(cartOpen ? "true" : "false")">
                🛒 Kurv (<span id="cartCount">@cartCount</span>)
            </button>
        </div>

        <div class="welcome-container">
            <div class="welcome-box">
                <h1>@restaurant?.Name</h1>
                <h2>Find din favorit, og gør dig klar til et lækkert måltid.</h2>
            </div>
        </div>
    </div>
</header>

@if (TempData["CartWarning"] is string warning)
{
    <div id="cartWarningPopup" class="cart-warning-overlay">
        <div class="cart-warning-popup" role="alert">
            <div class="cart-warning-icon">⚠️</div>
            <h2>Hey, vent lige!</h2>
            <p>@warning</p>
        </div>
    </div>
}

<main class="menu-page">

    <div class="menu-toolbar">
        <span class="menu-count">
            @foodItems.Count lækre valgmuligheder
        </span>

        @if (restaurant != null && !restaurant.IsAcceptingOrders)
        {
            <span class="restaurant-number">
                Restauranten modtager ikke bestillinger lige nu
            </span>
        }
    </div>

    @if (foodItems.Count == 0)
    {
        <div class="no-food">
            <h2>Ingen retter tilgængelige</h2>
            <p>Der er ingen tilgængelige retter på menuen lige nu.</p>
        </div>
    }
    else
    {
        <div class="food-grid">
            @foreach (var item in foodItems)
            {
                var currentPrice = item.Prices
                    .OrderByDescending(price => price.ValidFrom)
                    .FirstOrDefault();
                
                var ingredients = item.Ingredients?
                    .Where(i => i.Ingredient != null)
                    .ToList() ?? new List<FoodItemIngredient>();


                <article class="food-card">

                    <div class="food-image">
                        <span class="food-emoji">🍽️</span>
                        <span class="food-category">@item.Category</span>
                    </div>

                    <div class="food-content">

                        <h2>@item.Name</h2>
                        <p>@item.Description</p>

                        @if (currentPrice != null)
                        {
                            var basePrice = currentPrice.Amount;

                            @if (restaurant != null &&
                                 restaurant.IsAcceptingOrders)
                            {
                                <form asp-controller="Cart"
                                      asp-action="Add"
                                      method="post"
                                      class="customize-form">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="foodItemId"
                                           value="@item.FoodItemId" />

                                    <input type="hidden"
                                           name="restaurantId"
                                           value="@restaurant.RestaurantId" />

                                    <input type="hidden"
                                           name="quantity"
                                           value="1" />

                                    <input type="hidden"
                                           name="customizationSubmitted"
                                           value="true" />

                                    <div class="food-footer">

                                        <span class="food-price dynamic-price"
                                              data-base-price="@basePrice.ToString(CultureInfo.InvariantCulture)">
                                            @basePrice.ToString("0.00") kr.
                                        </span>

                                        <div class="food-actions">

                                            <!-- Almindelig tilføj-knap -->
                                            <button type="submit" class="add-button">
                                                + Tilføj til kurv
                                            </button>

                                            <button type="button"
                                                    class="customize-toggle"
                                                    aria-expanded="false">
                                                Tilpas ret
                                            </button>

                                        </div>
                                    </div>

                                    <div class="ingredient-dropdown hidden">

                                        <h3>Tilpas din ret</h3>

                                        @if (ingredients.Any())
                                        {
                                            @foreach (var ingredient in ingredients)
                                            {
                                                var defaultQuantity = ingredient.IsDefault ? 1 : 0;

                                                <div class="ingredient-row"
                                                     data-ingredient-id="@ingredient.IngredientId"
                                                     data-price="@ingredient.ExtraPrice.ToString(CultureInfo.InvariantCulture)">

                                                    <div class="ingredient-info">
                                                        <span>@ingredient.Ingredient!.Name</span>

                                                        @if (ingredient.ExtraPrice > 0)
                                                        {
                                                            <small>
                                                                +@ingredient.ExtraPrice.ToString("0.00") kr.
                                                            </small>
                                                        }
                                                        else
                                                        {
                                                            <small>Inkluderet</small>
                                                        }
                                                    </div>

                                                    <div class="ingredient-controls">

                                                        <button type="button" class="ingredient-minus">
                                                            −
                                                        </button>

                                                        <span class="ingredient-quantity">
                                                            @defaultQuantity
                                                        </span>

                                                        <button type="button" class="ingredient-plus">
                                                            +
                                                        </button>

                                                    </div>

                                                    <input type="hidden"
                                                           name="selectedIngredientIds"
                                                           value="@ingredient.IngredientId"
                                                           class="ingredient-selected"
                                                           disabled="@(!ingredient.IsDefault)" />

                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <p class="no-ingredients">
                                                Ingen ingredienser tilgængelige endnu.
                                            </p>
                                        }
                                    </div>

                                </form>
                            }
                            else
                            {
                                <div class="food-footer">
                                    <span class="food-price">
                                        @basePrice.ToString("0.00") kr.
                                    </span>
                                </div>
                            }
                        }
                        else
                        {
                            <span class="food-price">
                                Pris ikke tilgængelig
                            </span>
                        }

                    </div>
                </article>
            }

        </div>
    }

</main>

<!-- Overlay bag kurven -->
<div class="cart-overlay @(cartOpen ? "is-visible" : "")"
     id="cartOverlay">
</div>

<!-- Slide-out kurv -->
<aside class="cart-panel @(cartOpen ? "is-open" : "")"
       id="cartPanel"
       aria-label="Indkøbskurv"
       aria-hidden="@(!cartOpen ? "true" : "false")">

    <div class="cart-header">
        <div>
            <h2>Din indkøbskurv</h2>
            <span class="cart-subtitle">
                <span id="panelCartCount">@cartCount</span> varer
            </span>
        </div>

        <button type="button"
                class="cart-close"
                id="cartClose"
                aria-label="Luk indkøbskurv">
            ×
        </button>
    </div>

    <div class="cart-items" id="cartItems">

        @if (!cart.Any())
        {
            <div class="cart-empty">
                <span>🛒</span>
                <h3>Kurven er tom</h3>
                <p>Tilføj en lækker ret fra menuen.</p>
            </div>
        }
        else
        {
            @foreach (var item in cart)
            {
                <div class="cart-item">
                    <div class="cart-item-info">
                        <h3>@item.Name</h3>

                        @if (item.SelectedIngredients.Any())
                        {
                            <div class="cart-ingredients">
                                <strong>Tilpasninger:</strong>

                                @foreach (var ingredient in item.SelectedIngredients)
                                {
                                    <span>
                                        @ingredient.Name
                                        @if (ingredient.ExtraPrice > 0)
                                        {
                                            <text>(+@ingredient.ExtraPrice.ToString("0.00") kr.)</text>
                                        }
                                    </span>
                                }
                            </div>
                        }
                        @if (item.RemovedIngredients.Any())
                        {
                            <div class="cart-ingredients">
                                <strong>Fravalgt:</strong>

                                @foreach (var ingredient in item.RemovedIngredients)
                                {
                                    <span>Uden @ingredient</span>
                                }
                            </div>
                        }

                        <span>
                            @item.UnitPrice.ToString("0.00") kr. pr. stk.
                        </span>

                        <strong>
                            @item.SubTotal.ToString("0.00") kr.
                        </strong>
                    </div>

                    <div class="cart-item-actions">
                        <span>Antal: @item.Quantity</span>

                        <form asp-controller="Cart"
                              asp-action="Remove"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="foodItemId"
                                   value="@item.FoodItemId" />

                            <input type="hidden"
                                   name="restaurantId"
                                   value="@item.RestaurantId" />

                            <button type="submit"
                                    class="remove-button">
                                Fjern
                            </button>
                        </form>
                    </div>
                </div>
            }
        }
    </div>

    <div class="cart-footer">
        <div class="cart-total">
            <span>Total</span>
            <strong id="cartTotal">
                @cartTotal.ToString("0.00") kr.
            </strong>
        </div>

<button type="button"
        class="checkout-button"
        disabled="@(!cart.Any() || restaurant == null || !restaurant.IsAcceptingOrders)">
    Gå til bestilling →
</button>

@if (restaurant != null && !restaurant.IsAcceptingOrders)
{
    <p class="checkout-note">
        Online bestilling er midlertidigt lukket.
    </p>
}
else
{
    <p class="checkout-note">
        Bestillingsfunktionen tilføjes senere.
    </p>
}
    </div>

</aside>

