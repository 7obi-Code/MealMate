        }

    .cart-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.5rem;
        border-bottom: 1px solid #e7ebe7;
        flex-shrink: 0;
    }

        .cart-header h2 {
            margin: 0;
            color: #24382a;
        }

    .cart-subtitle {
        color: #68736b;
        font-size: .9rem;
    }

    .cart-close {
        border: 0;
