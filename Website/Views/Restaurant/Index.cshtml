        overflow-y: auto;
        padding: 1rem 1.5rem;
    }

    .cart-empty {
        text-align: center;
        padding: 4rem 1rem;
        color: #68736b;
    }

        .cart-empty span {
            font-size: 3rem;
        }

        .cart-empty h3 {
            color: #24382a;
        }

    .cart-item {
        display: flex;
        justify-content: space-between;
